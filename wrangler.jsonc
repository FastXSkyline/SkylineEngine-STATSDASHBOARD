{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skylineenginestats",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true [
      "/api/*",
      "/launch"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skylineenginestatsdb",
      "database_id": "19cf9e65-639f-4289-b2ef-c5d78696638f"
    }
  ]
}
